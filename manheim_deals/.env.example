# Copy this file to ".env" and fill in your Manheim API credentials.
# The .env file stays on YOUR machine and is git-ignored — never commit it.

MANHEIM_CLIENT_ID=your_client_id_here
MANHEIM_CLIENT_SECRET=your_client_secret_here

# Optional: only set these if your Manheim developer portal shows different URLs.
# MANHEIM_TOKEN_URL=https://api.manheim.com/oauth2/token
# MANHEIM_MMR_URL=https://api.manheim.com/valuations/vin/{vin}
